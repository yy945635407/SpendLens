<view class="share-page">

  <!-- 错误 -->
  <view wx:if="{{error}}" style="text-align:center;padding:120rpx 0;">
    <view style="font-size:96rpx;">📭</view>
    <view style="font-size:32rpx;color:var(--muted);margin-top:24rpx;">{{error}}</view>
  </view>

  <!-- 数据 -->
  <block wx:if="{{data}}">
    <view style="text-align:center;margin-bottom:40rpx;">
      <view style="font-size:36rpx;font-weight:700;color:var(--primary);">
        🌸 SpendLens  ·  {{data.month || ''}}
      </view>
      <view style="font-size:24rpx;color:var(--muted);margin-top:8rpx;" wx:if="{{data.health}}">
        {{data.health.grade}} · {{data.health.grade_text}}
      </view>
    </view>

    <!-- 统计卡片 -->
    <view style="display:flex;flex-wrap:wrap;gap:16rpx;margin-bottom:32rpx;">
      <view class="share-stat" wx:for="{{stats}}" wx:key="label" style="width:calc(50% - 10rpx);">
        <view style="font-size:32rpx;font-weight:700;">{{item.value}}</view>
        <view style="font-size:22rpx;color:var(--muted);">{{item.label}}</view>
      </view>
    </view>

    <!-- 分类 -->
    <view class="cat-list" wx:if="{{categories.length}}">
      <view style="font-size:28rpx;font-weight:700;margin-bottom:20rpx;">📂 支出一级分类</view>
      <view class="cat-item" wx:for="{{categories}}" wx:key="name">
        <view style="width:120rpx;font-size:24rpx;text-align:right;">{{item.name}}</view>
        <view style="flex:1;margin:0 16rpx;"><view style="height:14rpx;background:#FFE4EC;border-radius:7rpx;"><view style="height:100%;border-radius:7rpx;background:var(--primary);width:{{item.pct}};"></view></view></view>
        <view style="width:140rpx;font-size:22rpx;color:var(--muted);text-align:right;">{{item.amount}}</view>
      </view>
    </view>

    <!-- 建议 -->
    <view class="share-stat" wx:if="{{suggestions.length}}">
      <view style="font-size:28rpx;font-weight:700;margin-bottom:16rpx;">💡 建议</view>
      <view wx:for="{{suggestions}}" wx:key="*this" style="font-size:24rpx;color:var(--muted);padding:8rpx 0;">{{item}}</view>
    </view>

    <view style="text-align:center;font-size:20rpx;color:var(--muted);padding:60rpx 0;">
      Generated by SpendLens
    </view>
  </block>

</view>
