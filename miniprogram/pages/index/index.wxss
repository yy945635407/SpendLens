/* 首页样式 */

/* ====== 加载/进度弹窗 ====== */
.loading-overlay {
  position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(255,240,245,0.92);
  backdrop-filter: blur(8rpx);
  display: flex; align-items: center; justify-content: center; z-index: 999;
}
.loading-card {
  width: 520rpx; background: #FFF; border-radius: 48rpx; padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 16rpx 64rpx rgba(255,107,138,0.18);
  border: 2rpx solid rgba(255,107,138,0.10);
}
.loading-char-wrap {
  position: relative; width: 200rpx; height: 120rpx; margin: 0 auto 32rpx;
  overflow: visible;
}
.loading-runner {
  position: absolute; bottom: 24rpx; left: 0;
  font-size: 72rpx;
  animation: shinRun 0.7s ease-in-out infinite;
}
.loading-ground {
  position: absolute; bottom: 0; left: 10%; width: 80%; height: 6rpx;
  background: linear-gradient(90deg, transparent, #FFB3C6, transparent);
  border-radius: 3rpx;
  animation: groundPulse 0.7s ease-in-out infinite;
}
@keyframes shinRun {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
@keyframes groundPulse {
  0%, 100% { opacity: 0.4; transform: scaleX(1); }
  50% { opacity: 1; transform: scaleX(1.3); }
}
.loading-title {
  font-size: 32rpx; font-weight: 700; color: #5C2D3E; margin-bottom: 8rpx;
}
.loading-sub {
  font-size: 24rpx; color: #C4909E; margin-bottom: 28rpx;
}
.progress-bar-wrap {
  width: 100%; height: 12rpx; background: #FFE4EC; border-radius: 6rpx;
  margin: 16rpx 0 8rpx; overflow: hidden;
}
.progress-bar-fill {
  height: 100%; background: linear-gradient(90deg, #FFB3C6, #FF6B8A);
  border-radius: 6rpx; transition: width 0.4s ease;
}
.progress-pct-text {
  font-size: 28rpx; font-weight: 700; color: #FF6B8A; margin-bottom: 16rpx;
}
.loading-hints {
  margin: 16rpx 0 8rpx; padding-top: 12rpx;
  border-top: 1rpx solid rgba(255,107,138,0.08);
}
.hint-line {
  font-size: 20rpx; color: #C4909E; line-height: 1.6;
  text-align: center; padding: 2rpx 0;
}
.btn-cancel {
  margin-top: 20rpx; width: 200rpx; height: 64rpx;
  background: transparent; border: 2rpx solid #C4909E; border-radius: 32rpx;
  font-size: 26rpx; color: #C4909E; line-height: 64rpx;
}
.btn-cancel:active {
  background: rgba(196,144,158,0.08);
}
.loading-dots {
  display: flex; justify-content: center; gap: 12rpx;
}
.loading-dots .dot {
  width: 14rpx; height: 14rpx; background: #FF6B8A; border-radius: 50%;
  animation: dotBounce 0.6s ease-in-out infinite alternate;
}
@keyframes dotBounce {
  0% { transform: translateY(0); opacity: 0.3; }
  100% { transform: translateY(-16rpx); opacity: 1; }
}

/* 统计卡片 */
.stat-card {
  width: calc(33.33% - 12rpx);
  background: #FFF; border-radius: 32rpx; padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 28rpx rgba(255,107,138,0.10);
  border-left: 6rpx solid var(--primary); margin-bottom: 16rpx;
}
.stat-value { font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.stat-label { font-size: 26rpx; font-weight: 700; color: #3D1E2A; margin-bottom: 2rpx; }
.stat-en { font-size: 18rpx; color: var(--muted); margin-bottom: 4rpx; }
.stat-sub { font-size: 20rpx; color: var(--primary); }

/* 分类列表 */
.cat-item { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.cat-name { width: 120rpx; font-size: 24rpx; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-wrap { flex: 1; height: 14rpx; background: #FFE4EC; border-radius: 7rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 7rpx; transition: width 0.5s; }
.cat-amt { width: 140rpx; font-size: 22rpx; color: var(--muted); text-align: right; }
.cat-pct { font-size: 20rpx; color: var(--muted); width: 72rpx; text-align: right; }

/* 预算执行 */
.budget-comp-item { display: flex; align-items: center; gap: 6rpx; margin-bottom: 12rpx; font-size: 24rpx; }
.comp-label { width: 140rpx; text-align: left; display: flex; align-items: center; gap: 4rpx; overflow: hidden; flex-shrink: 0; }
.comp-amt { width: 120rpx; text-align: right; font-size: 22rpx; font-family: monospace; flex-shrink: 0; }
.comp-pct { font-size: 22rpx; color: var(--muted); width: 72rpx; text-align: right; flex-shrink: 0; }

/* 模拟卡片 */
.sim-card {
  width: calc(50% - 10rpx);
  background: #FFF; border-radius: 32rpx; padding: 28rpx;
  box-shadow: 0 4rpx 28rpx rgba(255,107,138,0.10);
  margin-bottom: 16rpx; border: 3rpx solid transparent; transition: all 0.2s;
}
.sim-card:active { border-color: var(--primary); }
.sim-title { font-size: 28rpx; font-weight: 700; }
.sim-desc { font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }

/* 规则项 */
.rule-item { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #FFE4EC; }
.rule-item:last-child { border-bottom: none; }

/* 上传区有文件时的样式 */
.upload-zone.has-file { border-color: var(--primary); background: #F5FAF8; }

/* ====== 详情弹窗 ====== */
.modal-overlay {
  position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(0,0,0,0.35);
  display: flex; align-items: center; justify-content: center; z-index: 1000;
}
.modal-card {
  width: 620rpx; max-height: 75vh; background: #FFF; border-radius: 40rpx;
  padding: 48rpx 36rpx 36rpx; overflow-y: auto;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
  position: relative;
}
.modal-close {
  position: absolute; top: 20rpx; right: 24rpx;
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--muted);
}
.modal-title {
  font-size: 36rpx; font-weight: 700; color: #3D1E2A; margin-bottom: 6rpx;
}
.modal-subtitle {
  font-size: 24rpx; color: var(--muted); margin-bottom: 28rpx;
}
.detail-content { }
.detail-formula {
  padding: 24rpx 28rpx; background: rgba(255,240,245,0.3);
  border-radius: 20rpx; margin-bottom: 20rpx;
  font-size: 24rpx; color: #3D1E2A; line-height: 1.8; white-space: pre-line;
}
.detail-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 18rpx; border-radius: 12rpx; margin-bottom: 4rpx;
}
.detail-name { font-size: 26rpx; color: #3D1E2A; flex: 1; }
.detail-amount { font-size: 26rpx; font-weight: 600; min-width: 140rpx; text-align: right; }
.detail-pct { font-size: 22rpx; min-width: 72rpx; text-align: right; opacity: 0.7; }
.detail-total {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 18rpx 0; margin-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

/* 预算执行无预算标签 */
.comp-pct.no-budget {
  font-size: 20rpx; color: var(--muted); width: 120rpx; text-align: right;
}
