/* 首页样式 */

/* ====== 加载/进度弹窗 ====== */
.loading-overlay {
  position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(255,240,245,0.92);
  backdrop-filter: blur(8rpx);
  display: flex; align-items: center; justify-content: center; z-index: 999;
}
.loading-card {
  width: 520rpx; background: #FFF; border-radius: 48rpx; padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 16rpx 64rpx rgba(255,107,138,0.18);
  border: 2rpx solid rgba(255,107,138,0.10);
}
.loading-char-wrap {
  position: relative; width: 200rpx; height: 120rpx; margin: 0 auto 32rpx;
  overflow: visible;
}
.loading-runner {
  position: absolute; bottom: 24rpx; left: 0;
  font-size: 72rpx;
  animation: shinRun 0.7s ease-in-out infinite;
}
.loading-ground {
  position: absolute; bottom: 0; left: 10%; width: 80%; height: 6rpx;
  background: linear-gradient(90deg, transparent, #FFB3C6, transparent);
  border-radius: 3rpx;
  animation: groundPulse 0.7s ease-in-out infinite;
}
@keyframes shinRun {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
@keyframes groundPulse {
  0%, 100% { opacity: 0.4; transform: scaleX(1); }
  50% { opacity: 1; transform: scaleX(1.3); }
}
.loading-title {
  font-size: 32rpx; font-weight: 700; color: #5C2D3E; margin-bottom: 8rpx;
}
.loading-sub {
  font-size: 24rpx; color: #C4909E; margin-bottom: 28rpx;
}
.loading-dots {
  display: flex; justify-content: center; gap: 12rpx;
}
.loading-dots .dot {
  width: 14rpx; height: 14rpx; background: #FF6B8A; border-radius: 50%;
  animation: dotBounce 0.6s ease-in-out infinite alternate;
}
@keyframes dotBounce {
  0% { transform: translateY(0); opacity: 0.3; }
  100% { transform: translateY(-16rpx); opacity: 1; }
}

/* 统计卡片 */
.stat-card {
  width: calc(33.33% - 12rpx);
  background: #FFF; border-radius: 32rpx; padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 28rpx rgba(255,107,138,0.10);
  border-left: 6rpx solid var(--primary); margin-bottom: 16rpx;
}
.stat-value { font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.stat-icon { font-size: 28rpx; margin-bottom: 4rpx; font-weight: 600; }
.stat-label { font-size: 26rpx; font-weight: 700; color: #3D1E2A; margin-bottom: 2rpx; }
.stat-en { font-size: 18rpx; color: var(--muted); margin-bottom: 4rpx; }
.stat-sub { font-size: 20rpx; color: var(--primary); }

/* 分类列表 */
.cat-item { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.cat-name { width: 120rpx; font-size: 24rpx; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-wrap { flex: 1; height: 14rpx; background: #FFE4EC; border-radius: 7rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 7rpx; transition: width 0.5s; }
.cat-amt { width: 140rpx; font-size: 22rpx; color: var(--muted); text-align: right; }
.cat-pct { font-size: 20rpx; color: var(--muted); width: 72rpx; text-align: right; }

/* 预算执行 */
.budget-comp-item { display: flex; align-items: center; gap: 8rpx; margin-bottom: 12rpx; font-size: 24rpx; }
.comp-label { width: 130rpx; text-align: right; }
.comp-amt { width: 120rpx; text-align: right; font-size: 22rpx; }
.comp-pct { font-size: 20rpx; color: var(--muted); width: 60rpx; }

/* 模拟卡片 */
.sim-card {
  width: calc(50% - 10rpx);
  background: #FFF; border-radius: 32rpx; padding: 28rpx;
  box-shadow: 0 4rpx 28rpx rgba(255,107,138,0.10);
  margin-bottom: 16rpx; border: 3rpx solid transparent; transition: all 0.2s;
}
.sim-card:active { border-color: var(--primary); }
.sim-title { font-size: 28rpx; font-weight: 700; }
.sim-desc { font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }

/* 规则项 */
.rule-item { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #FFE4EC; }
.rule-item:last-child { border-bottom: none; }

/* 上传区有文件时的样式 */
.upload-zone.has-file { border-color: var(--primary); background: #F5FAF8; }
